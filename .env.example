# iDB configuration. Copy to ~/.idb/.env (or ./.env) and fill in your keys.
# Keys are never read from the repository.

# --- Embedding (OpenAI-compatible endpoint) ---
# If this endpoint is unavailable, iDB falls back to the local
# BAAI/bge-small-zh-v1.5 sentence-transformers model (no key required).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
IDB_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM for schema inference and extraction (Anthropic-compatible) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
IDB_LLM_MODEL=claude-sonnet-4-6

# Reasoning models spend part of the budget on a thinking block; 4096 is too
# small and silently yields empty answers. Keep this at 16k or higher.
IDB_LLM_MAX_TOKENS=16384

# --- Behaviour ---
# Database location (default: ~/idb_data)
IDB_DB_PATH=
# Financial keyword boosting is off by default: on the reference corpus it
# lowered MRR@5 from 0.857 to 0.762 with no end-to-end gain. See README.
IDB_FINANCIAL_BOOST=0
